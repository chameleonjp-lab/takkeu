{
  "name": "takkeu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --base=/takkeu/",
    "test:release": "playwright test --config=playwright.release.config.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "preview": "vite preview",
    "test:release-guards": "node --test --test-isolation=none tests/release/*.test.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/three": "0.186.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.8.1"
  }
}
